#   ═══════════════════════════════════════════════════
#       DeepSeek——模型配置
#   ═══════════════════════════════════════════════════

# DeepSeek 平台的 API Key，调用模型时使用
#   敏感信息，切勿提交到 Git 仓库
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


#   ═══════════════════════════════════════════════════
#       数据库与连接池
#   ═══════════════════════════════════════════════════

# SQLite 数据库文件路径
#   相对路径：相对于项目根目录（如 data/yue.db）
#   绝对路径：如 D:/YueData/yue.db
#   父目录不存在时，启动会自动创建
DB_PATH=data/yue.db

# 是否在控制台打印 SQLAlchemy 生成的 SQL 语句
#   True  = 开发调试，能看到每条 SQL
#   False = 生产环境，减少日志噪音
SQLALCHEMY_ECHO=True

# 连接池中常驻的连接数
POOL_SIZE=5

# 连接池允许额外创建的最大连接数（突发流量时最多再加几个）
MAX_OVERFLOW=5

# 从连接池获取连接的最长等待秒数，超时抛 TimeoutError
POOL_TIMEOUT=10


#   ═══════════════════════════════════════════════════
#       应用信息
#   ═══════════════════════════════════════════════════

# 应用名称，显示在 /docs 和 /openapi.json 中
APP_NAME="Yue Agent"

# 应用版本号，显示在 API 文档中
APP_VERSION=0.1.0

# FastAPI 调试模式
#   True  = 异常直接返回 HTML traceback，会绕过全局异常处理器
#   False = 返回统一的 JSON 错误响应（推荐，生产必须 False）
APP_DEBUG=False

# OpenAPI 文档地址
#   留空（APP_OPENAPI_URL=）表示关闭 /openapi.json
APP_OPENAPI_URL=/openapi.json

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
#   大小写不敏感，代码里会自动转成大写
LOG_LEVEL=INFO


#   ═══════════════════════════════════════════════════
#       跨域 CORS
#   ═══════════════════════════════════════════════════

# 允许跨域访问的前端地址，多个用英文逗号分隔
#   例：http://localhost:5173,http://127.0.0.1:5173
#   写 "*" 表示允许所有源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 是否允许浏览器携带 Cookie / Authorization 等凭证
#   True 时 CORS_ORIGINS 不能为 "*"，必须写具体域名
#   项目当前未做鉴权，保持 False
CORS_ALLOW_CREDENTIALS=False


#   ═══════════════════════════════════════════════════
#       权限认证
#   ═══════════════════════════════════════════════════

# 前后端共享的 HMAC 签名密钥（不是最终 token）
# 前端在 .env 中配置同值：VITE_API_TOKEN=同一串密钥
# 前端用它给 {iat, exp} 签名，请求头携带：Authorization: Bearer <token>
# 建议前端 token 有效期 60~300 秒
# 敏感信息，切勿提交到 Git；泄露后重新生成并同步修改前后端
AUTH_TOKEN=请替换为随机生成的密钥

#   ═══════════════════════════════════════════════════
#       管理后台
#   ═══════════════════════════════════════════════════

# 管理后台登录账号
ADMIN_USERNAME=admin

# 管理后台登录密码（至少 8 位，敏感信息，切勿提交到仓库）
ADMIN_PASSWORD=请替换为强密码

# 管理后台会话 cookie 的签名密钥（至少 32 位）
# 必须和 AUTH_TOKEN 不同：AUTH_TOKEN 会下发到前端，不能用来签管理员会话
ADMIN_SESSION_SECRET=请替换为随机生成的 32 位以上密钥

# 登录状态有效期（秒），默认 1 小时
ADMIN_SESSION_TTL=3600

# 部署到 HTTPS 后改成 True，避免 cookie 明文传输
ADMIN_COOKIE_SECURE=False
